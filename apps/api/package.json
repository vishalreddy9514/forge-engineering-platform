{
  "name": "@forge/api",
  "version": "0.0.0",
  "private": true,
  "description": "Forge REST API (NestJS)",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch --preserveWatchOutput",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:unit && pnpm test:e2e && pnpm test:integration",
    "test:unit": "jest",
    "test:e2e": "jest --config test/jest-e2e.config.js",
    "test:integration": "jest --config test/jest-integration.config.js",
    "test:cov": "jest --coverage",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@forge/types": "workspace:*",
    "@nestjs/common": "11.2.6",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.6",
    "@nestjs/platform-express": "11.2.6",
    "@nestjs/swagger": "11.4.7",
    "@node-rs/argon2": "2.2.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "nestjs-pino": "5.2.1",
    "pg": "8.23.0",
    "pino": "10.3.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@forge/config": "workspace:*",
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.6",
    "@testcontainers/postgresql": "12.1.0",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "9.39.5",
    "jest": "30.5.2",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "supertest": "7.3.0",
    "ts-jest": "29.4.14",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
