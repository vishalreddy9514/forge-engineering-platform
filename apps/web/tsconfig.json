{
  "extends": "@forge/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "types": ["node", "jest", "@testing-library/jest-dom"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "src",
    "test-stubs",
    ".next/types/**/*.ts",
    "next.config.ts",
    "jest.setup.ts"
  ],
  "exclude": ["node_modules"]
}
