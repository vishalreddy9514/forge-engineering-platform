# Copy to .env (`cp .env.example .env`). Every app and docker compose read this one file;
# an app-level .env (e.g. apps/api/.env) overrides it for that app only.
# Values here are for local development only. Deployed environments use SSM Parameter Store.

NODE_ENV=development

# ---- Infrastructure (docker compose) ----
POSTGRES_USER=forge
POSTGRES_PASSWORD=forge_dev_password
POSTGRES_DB=forge
POSTGRES_PORT=5432
REDIS_PORT=6379
# Login for the AI service's restricted database role (created on first `infra:up`).
AI_DB_PASSWORD=forge_ai_dev_password
SMTP_PORT=1025
# S3-compatible object storage (SeaweedFS) for attachments
S3_PORT=8333
MAILPIT_UI_PORT=8025

# ---- API (apps/api) ----
DATABASE_URL=postgresql://forge:forge_dev_password@localhost:5432/forge
# Integration tests start their own throwaway Postgres (Testcontainers) and ignore this.
API_PORT=4000
LOG_LEVEL=debug
LOG_PRETTY=true
REDIS_URL=redis://localhost:6379
# Browser origins allowed to call the API cross-origin. The web app normally calls it
# same-origin through the /api rewrite, so this is mainly for tools running on other ports.
CORS_ORIGINS=http://localhost:3000
# Swagger UI at http://localhost:4000/api/docs (defaults to on outside production).
# SWAGGER_ENABLED=true
TRUST_PROXY_HOPS=0

# Authentication. Without JWT keys the API generates a throwaway pair at startup (dev only;
# required in production). Generate a pair with: node apps/api/scripts/generate-jwt-keys.mjs
# JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n..."
# JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n..."
WEB_ORIGIN=http://localhost:3000
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
PASSWORD_RESET_TTL_MINUTES=30
# Reject passwords found in public breaches (Have I Been Pwned range API; fails open).
HIBP_ENABLED=true

# Email (Mailpit locally: every message appears at http://localhost:8025)
SMTP_HOST=localhost
SMTP_SECURE=false
MAIL_FROM="Forge <no-reply@forge.local>"

# Attachments (S3). Locally: SeaweedFS from docker compose; the keys match
# infrastructure/docker/seaweedfs/s3.json. In AWS leave the endpoint and keys unset: the SDK
# uses the task role, and Terraform owns the bucket and its CORS rule.
S3_ENDPOINT=http://localhost:8333
S3_REGION=us-east-1
S3_BUCKET=forge-attachments
S3_ACCESS_KEY_ID=forge
S3_SECRET_ACCESS_KEY=forge_dev_storage_secret
S3_FORCE_PATH_STYLE=true
# Create the bucket and allow browser uploads from WEB_ORIGIN at startup (local dev only).
S3_ENSURE_BUCKET=true

# ---- Web (apps/web) ----
# Where the Next.js server forwards /api/* requests.
API_INTERNAL_URL=http://localhost:4000

# ---- AI service (apps/ai-service) ----
AI_LOG_LEVEL=INFO
AI_LOG_JSON=false
# Least-privilege connection: can only read/write the RAG tables (ADR-0004).
AI_DATABASE_URL=postgresql://forge_ai_service:forge_ai_dev_password@localhost:5432/forge
# Shared secret between the API/worker and the AI service (min 32 chars).
# Generate one with: openssl rand -hex 32
AI_SERVICE_TOKEN=local-dev-only-token-change-me-0123456789
